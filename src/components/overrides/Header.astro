---
// src/components/overrides/Header.astro
import type { Props } from "@astrojs/starlight/components/Header.astro";

const { labels, socialIcons, siteTitle, search, themeSelect, localeSelect, mobileMenuToggle } =
  Astro.props as Props;
---

<header class="sl-header custom-header">
  {/* Your custom navbar */}
  <nav class="custom-navbar">
    <a href="/" class="custom-logo">MyBrand</a>

    <ul class="custom-nav-links">
      <li><a href="/product-builder-handbook/">Handbook</a></li>
      <li><a href="/blog/">Blog</a></li>
      <li><a href="/about/">About</a></li>
    </ul>
  </nav>

  {/* Keep default right-side controls if you want */}
  <div class="sl-header-right">
    {search}
    {themeSelect}
    {localeSelect}
    {socialIcons}
  </div>

  {mobileMenuToggle}
</header>

<style>
  .custom-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1rem;
  }

  .custom-navbar {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .custom-logo {
    font-weight: 700;
    font-size: 1.1rem;
    text-decoration: none;
  }

  .custom-nav-links {
    display: flex;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .custom-nav-links a {
    text-decoration: none;
    color: var(--sl-color-text);
  }

  .sl-header-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  @media (max-width: 48rem) {
    .custom-nav-links {
      display: none;
    }
  }
</style>