---
// src/components/overrides/Footer.astro
import type { Props } from "@astrojs/starlight/components/Footer.astro";

const { lastUpdated, pagination } = Astro.props as Props;
---

<footer class="custom-footer">
  <div class="custom-footer-content">
    <p>© {new Date().getFullYear()} FonijBuild. What do we build for, if not to lessen each other’s hardship?</p>

    {/* Optionally keep last updated / pagination */}
    {lastUpdated}
    {pagination}
  </div>
</footer>

<style>
  .custom-footer {
    border-top: 1px solid var(--sl-color-hairline);
    padding: 1.5rem 1rem;
    margin-top: 3rem;
  }

  .custom-footer-content {
    max-width: var(--sl-content-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: center;
    text-align: center;
  }
</style>